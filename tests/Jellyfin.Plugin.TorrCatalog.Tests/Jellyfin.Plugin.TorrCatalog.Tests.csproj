<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin excludes Jellyfin runtime assets (the server provides them); tests need them. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jellyfin.Plugin.TorrCatalog\Jellyfin.Plugin.TorrCatalog.csproj" />
  </ItemGroup>

</Project>
